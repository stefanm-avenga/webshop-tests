{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "type": "command",
        "bash": "python3 .github/hooks/audit-logging/verifier_pretooluse.py",
        "powershell": "python .github/hooks/audit-logging/verifier_pretooluse.py",
        "cwd": ".",
        "timeoutSec": 5
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "bash": "python3 .github/hooks/audit-logging/verifier_postuse.py",
        "powershell": "python .github/hooks/audit-logging/verifier_postuse.py",
        "cwd": ".",
        "timeoutSec": 10
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "bash": "python3 .github/hooks/audit-logging/verifier_stop.py",
        "powershell": "python .github/hooks/audit-logging/verifier_stop.py",
        "cwd": ".",
        "timeoutSec": 5
      }
    ],
    "subagentStop": [
      {
        "type": "command",
        "bash": "python3 .github/hooks/audit-logging/verifier_stop.py",
        "powershell": "python .github/hooks/audit-logging/verifier_stop.py",
        "cwd": ".",
        "timeoutSec": 5
      }
    ]
  }
}
